#!/bin/sh
# Generate kanban board artifacts before commit.
# Install: git config core.hooksPath scripts/hooks

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

node "$ROOT/scripts/threads.js" --html 2>&1
node "$ROOT/scripts/threads.js" --obsidian 2>&1

git add "$ROOT/dist/threads.html" "$ROOT/dist/threads.kanban.md" 2>/dev/null
